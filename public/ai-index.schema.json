{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openjobs.genedai.me/ai-index.schema.json",
  "title": "AI Recruiting Evaluation Library agent resource index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "canonical_site",
    "name",
    "description",
    "language",
    "last_substantive_review",
    "preferred_entrypoints",
    "citation_guidance",
    "limitations",
    "access_policy",
    "entities",
    "pages",
    "downloads",
    "sources"
  ],
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "schema_version": {"type": "string", "const": "1.1"},
    "canonical_site": {"type": "string", "format": "uri"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "language": {"type": "string", "const": "en"},
    "last_substantive_review": {"type": "string", "format": "date"},
    "preferred_entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery", "full_context", "structured_index"],
      "properties": {
        "discovery": {"type": "string", "format": "uri"},
        "full_context": {"type": "string", "format": "uri"},
        "structured_index": {"type": "string", "format": "uri"}
      }
    },
    "citation_guidance": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "access_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["robots", "search_and_retrieval", "model_development"],
      "properties": {
        "robots": {"type": "string", "format": "uri"},
        "search_and_retrieval": {"type": "string", "enum": ["allowed", "disallowed"]},
        "model_development": {"type": "string", "enum": ["allowed", "disallowed"]}
      }
    },
    "entities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entity"}},
    "pages": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/page"}},
    "downloads": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/download"}},
    "sources": {"type": "array", "minItems": 18, "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "relationship"],
      "properties": {
        "name": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "relationship": {"type": "string"}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "canonical_url", "markdown_url", "summary", "topics", "downloads"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string"},
        "canonical_url": {"type": "string", "format": "uri"},
        "markdown_url": {"type": "string", "format": "uri"},
        "summary": {"type": "string"},
        "topics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "downloads": {"type": "array", "items": {"type": "string", "format": "uri"}, "uniqueItems": true}
      }
    },
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "media_type", "description", "license"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "media_type": {"type": "string", "enum": ["text/csv", "application/json"]},
        "description": {"type": "string"},
        "license": {"type": "string"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "organization", "title", "url", "source_type", "jurisdiction", "last_checked", "supports", "does_not_prove"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "organization": {"type": "string"},
        "title": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "source_type": {"type": "string", "enum": ["binding-rule", "government-guidance", "voluntary-framework", "technical-standard", "professional-practice", "first-party-research"]},
        "jurisdiction": {"type": "string"},
        "last_checked": {"type": "string", "format": "date"},
        "supports": {"type": "string"},
        "does_not_prove": {"type": "string"}
      }
    }
  }
}
