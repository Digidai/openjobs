{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openjobs.genedai.me/ai-index.schema.json",
  "title": "AI Recruiting Field Guide agent resource index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "canonical_site",
    "name",
    "description",
    "language",
    "last_substantive_review",
    "preferred_entrypoints",
    "citation_guidance",
    "limitations",
    "access_policy",
    "entities",
    "pages",
    "sources"
  ],
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "canonical_site": {"type": "string", "format": "uri"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "language": {"type": "string", "const": "en"},
    "last_substantive_review": {"type": "string", "format": "date"},
    "preferred_entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery", "full_context", "structured_index"],
      "properties": {
        "discovery": {"type": "string", "format": "uri"},
        "full_context": {"type": "string", "format": "uri"},
        "structured_index": {"type": "string", "format": "uri"}
      }
    },
    "citation_guidance": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "access_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["robots", "search_and_retrieval", "model_development"],
      "properties": {
        "robots": {"type": "string", "format": "uri"},
        "search_and_retrieval": {"type": "string", "enum": ["allowed", "disallowed"]},
        "model_development": {"type": "string", "enum": ["allowed", "disallowed"]}
      }
    },
    "entities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entity"}},
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "relationship"],
      "properties": {
        "name": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "relationship": {"type": "string"}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "canonical_url", "markdown_url", "summary", "topics"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string"},
        "canonical_url": {"type": "string", "format": "uri"},
        "markdown_url": {"type": "string", "format": "uri"},
        "summary": {"type": "string"},
        "topics": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "source_type", "supports", "does_not_prove"],
      "properties": {
        "name": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "source_type": {"type": "string", "enum": ["public-framework", "government-guidance", "first-party-research"]},
        "supports": {"type": "string"},
        "does_not_prove": {"type": "string"}
      }
    }
  }
}
